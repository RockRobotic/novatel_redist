; --------------------------------------------
; conversions from one datum to another
; --------------------------------------------

;Convert {
;     From: datum_name
;     To:   WGS84
;     Info: VER602
;     Default: 0
;
;     Type: 3PARAM
;     Offset: dx dy dz        
;}

Convert {
     From: ED50
     To:   WGS84
     Info: NIMA-7Param
     Default: 0

     Type: 7PARAM
     Offset: -102 -102 -129
     Angle: 0.413 -0.184 0.385 1
     Scale: 0.0000024664    
}
Convert {
     From: OSGB36
     To:   WGS84
     Info: 7-Parameter
     Default: 1

     Type: 7PARAM
     Offset: 446 -99 544
     Angle: -0.945 -0.261 -0.435    
     Scale: -0.0000208927
}
; gda 94, itrf90,94,96
Convert {
     From: GDA94
     To:   WGS84
     Info: AusLig
     Default: 0
     Type: 3PARAM
     Offset: 0 0 0
}
Convert {
     From: AGD84
     To:   WGS84
     Info: AusLig
     Default: 1

     Type: 7PARAM
     Offset: -117.763 -51.510 139.061
     Angle: -0.292 -0.443 -0.277 1
     Scale: -0.191
}     
Convert {
     From: AGD84
     To:   GDA94
     Info: AusLig
     Default: 1

     Type: 7PARAM
     Offset: -117.763 -51.510 139.061
     Angle: -0.292 -0.443 -0.277 1
     Scale: -0.191
}     
Convert {
        From: ED50
        To:   WGS84
        Info: DK-7PARAM
        Default: 1
        
        Type: 7PARAM
        Offset: -81.070 -89.360 -115.753   ; m
        Angle:  -0.48488 -0.02436 -0.41321 1          ; arcsec
        Scale: -0.540645
}
Convert {        ; WGS84 to SLD99 (Sri_Lanka) 
	From: WGS84
	To: SLD99
	Info: Sri_Lanka
	Default: 1
	Type: 7PARAM
	Offset: 0.2930 -766.9500 -87.7130 ; m
	Angle: 0.19570 1.69510 3.47300 1 ; arc-sec
	Scale: 0.039300000000 ; ppm
 }
 Convert {        ; WGS84 to Israel (Israel) 
	From: WGS84
	To: Israel
